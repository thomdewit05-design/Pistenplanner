{
  "appId": "nl.skipilot.app",
  "appName": "Skipilot",
  "webDir": "www",
  "backgroundColor": "#0F1B2A",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0F1B2A",
    "limitsNavigationsToAppBoundDomains": false,
    "includePlugins": [
      "@capacitor-community/admob",
      "@capacitor-community/keep-awake"
    ]
  },
  "android": {
    "backgroundColor": "#0F1B2A"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover"
    }
  }
}
